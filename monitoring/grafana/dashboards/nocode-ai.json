{
  "uid": "nocode-ai",
  "title": "NoCode · AI 调用监控",
  "description": "大模型调用次数、成功率、Token 消耗、响应时间与排行（教程第 13 节）",
  "tags": [
    "nocode",
    "ai"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "model",
        "label": "模型",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ai_model_requests_total, model_name)",
          "refId": "model"
        },
        "definition": "label_values(ai_model_requests_total, model_name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "AI 调用次数",
      "description": "所选时间范围内向大模型发起的请求数（VUE 工程每轮工具调用都算一次）",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(((ai_model_requests_total{model_name=~\"$model\",status=\"started\"} unless ai_model_requests_total{model_name=~\"$model\",status=\"started\"} offset $__range) or increase(ai_model_requests_total{model_name=~\"$model\",status=\"started\"}[$__range])))",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "成功率",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(((ai_model_requests_total{model_name=~\"$model\",status=\"success\"} unless ai_model_requests_total{model_name=~\"$model\",status=\"success\"} offset $__range) or increase(ai_model_requests_total{model_name=~\"$model\",status=\"success\"}[$__range]))) / sum(((ai_model_requests_total{model_name=~\"$model\",status=\"started\"} unless ai_model_requests_total{model_name=~\"$model\",status=\"started\"} offset $__range) or increase(ai_model_requests_total{model_name=~\"$model\",status=\"started\"}[$__range])))",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.98
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "错误次数",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(((ai_model_errors_total{model_name=~\"$model\"} unless ai_model_errors_total{model_name=~\"$model\"} offset $__range) or increase(ai_model_errors_total{model_name=~\"$model\"}[$__range]))) or vector(0)",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Token 消耗",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(((ai_model_tokens_total{model_name=~\"$model\",token_type=\"total\"} unless ai_model_tokens_total{model_name=~\"$model\",token_type=\"total\"} offset $__range) or increase(ai_model_tokens_total{model_name=~\"$model\",token_type=\"total\"}[$__range])))",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 13,
        "y": 0,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "平均响应时间",
      "description": "单次模型请求的平均耗时（流式请求从发出到最后一个片段）",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(((ai_model_response_duration_seconds_sum{model_name=~\"$model\"} unless ai_model_response_duration_seconds_sum{model_name=~\"$model\"} offset $__range) or increase(ai_model_response_duration_seconds_sum{model_name=~\"$model\"}[$__range]))) / sum(((ai_model_response_duration_seconds_count{model_name=~\"$model\"} unless ai_model_response_duration_seconds_count{model_name=~\"$model\"} offset $__range) or increase(ai_model_response_duration_seconds_count{model_name=~\"$model\"}[$__range])))",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "调用次数趋势（每分钟）",
      "description": "",
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (((ai_model_requests_total{model_name=~\"$model\",status!=\"started\"} unless ai_model_requests_total{model_name=~\"$model\",status!=\"started\"} offset 1m) or increase(ai_model_requests_total{model_name=~\"$model\",status!=\"started\"}[1m])))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "auto",
            "pointSize": 6,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Token 消耗趋势（每分钟）",
      "description": "input 为输入（含历史上下文），output 为模型输出",
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (token_type) (((ai_model_tokens_total{model_name=~\"$model\",token_type!=\"total\"} unless ai_model_tokens_total{model_name=~\"$model\",token_type!=\"total\"} offset 1m) or increase(ai_model_tokens_total{model_name=~\"$model\",token_type!=\"total\"}[1m])))",
          "legendFormat": "{{token_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "auto",
            "pointSize": 6,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "响应时间百分位（5 分钟窗口）",
      "description": "",
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (((ai_model_response_duration_seconds_bucket{model_name=~\"$model\"} unless ai_model_response_duration_seconds_bucket{model_name=~\"$model\"} offset 5m) or increase(ai_model_response_duration_seconds_bucket{model_name=~\"$model\"}[5m]))))",
          "legendFormat": "P50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum by (le) (((ai_model_response_duration_seconds_bucket{model_name=~\"$model\"} unless ai_model_response_duration_seconds_bucket{model_name=~\"$model\"} offset 5m) or increase(ai_model_response_duration_seconds_bucket{model_name=~\"$model\"}[5m]))))",
          "legendFormat": "P90",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (((ai_model_response_duration_seconds_bucket{model_name=~\"$model\"} unless ai_model_response_duration_seconds_bucket{model_name=~\"$model\"} offset 5m) or increase(ai_model_response_duration_seconds_bucket{model_name=~\"$model\"}[5m]))))",
          "legendFormat": "P99",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "pointSize": 6,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "错误次数（每分钟，按异常类型）",
      "description": "",
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error_type) (((ai_model_errors_total{model_name=~\"$model\"} unless ai_model_errors_total{model_name=~\"$model\"} offset 1m) or increase(ai_model_errors_total{model_name=~\"$model\"}[1m])))",
          "legendFormat": "{{error_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "auto",
            "pointSize": 6,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "应用 Token 消耗 Top 10",
      "description": "app_id 为 unknown 的是创建应用时的路由选择等不属于具体对话的调用",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (app_id) (((ai_model_tokens_total{model_name=~\"$model\",token_type=\"total\"} unless ai_model_tokens_total{model_name=~\"$model\",token_type=\"total\"} offset $__range) or increase(ai_model_tokens_total{model_name=~\"$model\",token_type=\"total\"}[$__range]))))",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "app_id": "app ID",
              "Value": "数值"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "数值",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "app ID"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "数值"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlYlRd"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
